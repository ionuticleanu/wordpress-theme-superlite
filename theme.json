{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "740px",
			"wideSize": "1280px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"name": "Base",
					"slug": "base",
					"color": "#ffffff"
				},
				{
					"name": "Contrast",
					"slug": "contrast",
					"color": "#111827"
				},
				{
					"name": "Primary",
					"slug": "primary",
					"color": "#2563eb"
				},
				{
					"name": "Secondary",
					"slug": "secondary",
					"color": "#0f172a"
				},
				{
					"name": "Accent",
					"slug": "accent",
					"color": "#f59e0b"
				},
				{
					"name": "Muted Surface",
					"slug": "muted",
					"color": "#f3f4f6"
				},
				{
					"name": "Border",
					"slug": "border",
					"color": "#e5e7eb"
				}
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"name": "System Sans",
					"slug": "sans",
					"fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
				},
				{
					"name": "Monospace",
					"slug": "mono",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
				}
			],
			"fontSizes": [
				{
					"name": "Small",
					"slug": "sm",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"name": "Base",
					"slug": "base",
					"size": "1.125rem",
					"fluid": {
						"min": "1rem",
						"max": "1.125rem"
					}
				},
				{
					"name": "Large",
					"slug": "lg",
					"size": "1.25rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					}
				},
				{
					"name": "XL",
					"slug": "xl",
					"size": "1.5rem",
					"fluid": {
						"min": "1.25rem",
						"max": "1.5rem"
					}
				},
				{
					"name": "2XL",
					"slug": "2xl",
					"size": "2rem",
					"fluid": {
						"min": "1.5rem",
						"max": "2rem"
					}
				},
				{
					"name": "3XL",
					"slug": "3xl",
					"size": "2.75rem",
					"fluid": {
						"min": "2rem",
						"max": "2.75rem"
					}
				},
				{
					"name": "4XL",
					"slug": "4xl",
					"size": "3.5rem",
					"fluid": {
						"min": "2.5rem",
						"max": "3.5rem"
					}
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": ["px", "rem", "em", "%", "vh", "vw"],
			"spacingSizes": [
				{
					"name": "2XS",
					"slug": "2xs",
					"size": "0.5rem"
				},
				{
					"name": "XS",
					"slug": "xs",
					"size": "1rem"
				},
				{
					"name": "Small",
					"slug": "sm",
					"size": "1.5rem"
				},
				{
					"name": "Medium",
					"slug": "md",
					"size": "clamp(1.5rem, 3vw, 2.5rem)"
				},
				{
					"name": "Large",
					"slug": "lg",
					"size": "clamp(2.5rem, 5vw, 4rem)"
				},
				{
					"name": "XL",
					"slug": "xl",
					"size": "clamp(3.5rem, 7vw, 6rem)"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--sm)",
			"padding": {
				"left": "var(--wp--preset--spacing--sm)",
				"right": "var(--wp--preset--spacing--sm)"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"typography": {
						"textDecoration": "none"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": {
					"radius": "0.375rem"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--secondary)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--4xl)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--3xl)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--2xl)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xl)"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}